# GSM-01 — sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# --- Cơ sở dữ liệu: Neon PostgreSQL (ADR-002) ---
# Lấy tại https://console.neon.tech → Connection string (có sslmode=require)
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# --- LLM: Gemini là chính, OpenRouter là dự phòng (ADR-001, ADR-008) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Model đã đo TTFT thực tế, xem ADR-008. Không đổi khi chưa đo lại. ---
LLM_ROUTER_MODEL=gemini-3.5-flash-lite
LLM_ANSWER_MODEL=gemini-3.5-flash-lite
LLM_EMBEDDING_MODEL=gemini-embedding-001
LLM_EMBEDDING_DIM=768
# Hạn mức gói free tính THEO PHÚT và THEO TỪNG MODEL. Client tự giãn nhịp để không
# bao giờ chạm 429 (xem ADR-012). Lưu ý: router và bước trả lời cùng dùng
# gemini-3.5-flash-lite nên CHIA CHUNG một rổ 15 lần/phút — mỗi lượt chat tốn 2 lần gọi.
GEMINI_RPM=15

# --- Xác thực (T-009) ---
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-that-truoc-khi-deploy
JWT_EXPIRE_MINUTES=720

# --- Provider dự phòng (chuẩn OpenAI). Đổi provider = đổi 4 biến này, KHÔNG sửa code. ---
# Mặc định là OpenRouter. Để dùng AgentRouter:
#   FALLBACK_BASE_URL=https://agentrouter.org/v1
#   FALLBACK_MODEL=<tên model lấy từ agentrouter.org/console>
#   FALLBACK_PROVIDER_NAME=agentrouter
#   FALLBACK_API_KEY=<khoá>
FALLBACK_BASE_URL=https://api.tokenrouter.com/v1
FALLBACK_MODEL=qwen/qwen3.8-max-free
FALLBACK_PROVIDER_NAME=tokenrouter
FALLBACK_API_KEY=
# Tham số riêng của provider, dạng JSON. qwen3.8 là model reasoning và KHÔNG cho
# tắt suy luận, nên phải hạ mức suy luận xuống thấp nhất (ADR-011).
FALLBACK_EXTRA_BODY={"reasoning_effort":"low"}
# Model reasoning tiêu max_tokens cho phần suy luận TRƯỚC khi phát ra chữ nào.
# Đo được: max_tokens=300 -> 301 reasoning token và 0 ký tự nội dung.
FALLBACK_MIN_MAX_TOKENS=800
